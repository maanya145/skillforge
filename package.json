{
  "name": "skillforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "mastra:dev": "dotenv -e .env.local -e .env -- mastra dev",
    "mastra:build": "dotenv -e .env.local -e .env -- mastra build",
    "db:generate": "NODE_OPTIONS=--dns-result-order=ipv4first dotenv -e .env.local -e .env -- drizzle-kit generate",
    "db:push": "NODE_OPTIONS=--dns-result-order=ipv4first dotenv -e .env.local -e .env -- drizzle-kit push",
    "db:studio": "NODE_OPTIONS=--dns-result-order=ipv4first dotenv -e .env.local -e .env -- drizzle-kit studio",
    "db:seed": "NODE_OPTIONS=\"--dns-result-order=ipv4first --conditions=react-server\" dotenv -e .env.local -e .env -- tsx src/db/seed/index.mts",
    "db:demo": "NODE_OPTIONS=\"--dns-result-order=ipv4first --conditions=react-server\" dotenv -e .env.local -e .env -- tsx src/db/seed/demo-student.mts",
    "check:pdf": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-pdf.mts",
    "check:models": "NODE_OPTIONS=--conditions=react-server dotenv -e .env.local -e .env -- node scripts/check-models.mjs",
    "check:design": "NODE_OPTIONS=--conditions=react-server node scripts/check-design.mjs",
    "db:migrate": "NODE_OPTIONS=--dns-result-order=ipv4first dotenv -e .env.local -e .env -- drizzle-kit migrate",
    "db:state": "NODE_OPTIONS=\"--dns-result-order=ipv4first --conditions=react-server\" dotenv -e .env.local -e .env -- node scripts/db-state.mjs",
    "check:agent": "NODE_OPTIONS=--conditions=react-server dotenv -e .env.local -e .env -- tsx scripts/check-agent.mts",
    "check:workflow": "NODE_OPTIONS=\"--dns-result-order=ipv4first --conditions=react-server\" dotenv -e .env.local -e .env -- tsx scripts/check-workflow.mts",
    "check:mentor": "NODE_OPTIONS=\"--dns-result-order=ipv4first --conditions=react-server\" dotenv -e .env.local -e .env -- tsx scripts/check-mentor.mts",
    "check:tools": "NODE_OPTIONS=\"--dns-result-order=ipv4first --conditions=react-server\" dotenv -e .env.local -e .env -- tsx scripts/check-tool-labels.mts",
    "check:ocr": "NODE_OPTIONS=\"--dns-result-order=ipv4first --conditions=react-server\" dotenv -e .env.local -e .env -- tsx scripts/check-ocr.mts",
    "check:portfolio": "NODE_OPTIONS=\"--dns-result-order=ipv4first --conditions=react-server\" dotenv -e .env.local -e .env -- tsx scripts/check-portfolio.mts",
    "check:discovery": "NODE_OPTIONS=\"--dns-result-order=ipv4first --conditions=react-server\" dotenv -e .env.local -e .env -- tsx scripts/check-discovery.mts",
    "genui:prompt": "npx --yes @openuidev/cli@latest generate src/components/genui/library.tsx --out src/generated/openui-system-prompt.txt --no-telemetry && node scripts/inline-genui-prompt.mjs",
    "check:studio": "NODE_OPTIONS=\"--dns-result-order=ipv4first --conditions=react-server\" dotenv -e .env.local -e .env -- tsx scripts/check-studio.mts",
    "check:feed": "NODE_OPTIONS=\"--dns-result-order=ipv4first --conditions=react-server\" dotenv -e .env.local -e .env -- tsx scripts/check-feed.mts",
    "check:greeter": "NODE_OPTIONS=\"--dns-result-order=ipv4first --conditions=react-server\" dotenv -e .env.local -e .env -- tsx scripts/check-greeter.mts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.4",
    "@mastra/core": "^1.58.0",
    "@neondatabase/serverless": "^1.1.0",
    "@openuidev/react-lang": "^0.2.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "mastra": "^1.24.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
