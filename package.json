{
  "name": "skillforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "mastra:dev": "dotenv -e .env.local -e .env -- mastra dev",
    "mastra:build": "dotenv -e .env.local -e .env -- mastra build",
    "db:generate": "NODE_OPTIONS=--dns-result-order=ipv4first dotenv -e .env.local -e .env -- drizzle-kit generate",
    "db:push": "NODE_OPTIONS=--dns-result-order=ipv4first dotenv -e .env.local -e .env -- drizzle-kit push",
    "db:studio": "NODE_OPTIONS=--dns-result-order=ipv4first dotenv -e .env.local -e .env -- drizzle-kit studio",
    "db:seed": "NODE_OPTIONS=--dns-result-order=ipv4first dotenv -e .env.local -e .env -- tsx src/db/seed/index.mts",
    "db:demo": "NODE_OPTIONS=--dns-result-order=ipv4first dotenv -e .env.local -e .env -- tsx src/db/seed/demo-student.mts",
    "check:pdf": "tsx scripts/check-pdf.mts",
    "check:models": "dotenv -e .env.local -e .env -- node scripts/check-models.mjs",
    "check:design": "node scripts/check-design.mjs",
    "db:migrate": "NODE_OPTIONS=--dns-result-order=ipv4first dotenv -e .env.local -e .env -- drizzle-kit migrate",
    "db:state": "NODE_OPTIONS=--dns-result-order=ipv4first dotenv -e .env.local -e .env -- node scripts/db-state.mjs",
    "check:agent": "dotenv -e .env.local -e .env -- tsx scripts/check-agent.mts",
    "check:workflow": "NODE_OPTIONS=--dns-result-order=ipv4first dotenv -e .env.local -e .env -- tsx scripts/check-workflow.mts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.4",
    "@mastra/ai-sdk": "^1.8.0",
    "@mastra/core": "^1.58.0",
    "@mastra/memory": "^1.26.1",
    "@mastra/pg": "^1.20.0",
    "@neondatabase/serverless": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.17.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "mastra": "^1.24.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
