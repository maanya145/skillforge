# Copy to .env.local. Most of these arrive automatically from `vercel env pull .env.local`
# after `vercel install neon` and `vercel install clerk` — see docs/SETUP.md.

# ── Neon Postgres (injected by the Vercel integration) ────────────────────────
# Pooled (PgBouncer) — runtime app queries AND Mastra's PostgresStore
DATABASE_URL="postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct — drizzle-kit / DDL ONLY. Transaction pooling makes DDL unreliable.
DATABASE_URL_UNPOOLED="postgres://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ── Clerk (injected by the Vercel integration) ────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/app/intake"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/app/intake"

# ── Model gateway ─────────────────────────────────────────────────────────────
# Nothing to add: OpenCode Zen serves its free models unauthenticated.
# A real key lifts the shared rate limits; a placeholder BREAKS things (Zen
# 401s an invalid token but accepts no token at all).
# OPENCODE_API_KEY=""

# ── OCR fallback (optional) ───────────────────────────────────────────────────
# Only used when a PDF has NO text layer — a scan, a photo, a Canva export or
# outlined LaTeX. Without it those uploads are told to use "Paste the text",
# which still works; with it they are OCR'd through Firecrawl's /v2/parse.
#
# This is the one place a resume leaves our infrastructure, so it is off unless
# the key is set. Costs ~1 credit per page. https://firecrawl.dev
# FIRECRAWL_API_KEY=""

# ── App ───────────────────────────────────────────────────────────────────────
# Mastra's memory/trace tables live in their own schema so drizzle-kit never
# proposes dropping them. See drizzle.config.ts `schemaFilter`.
MASTRA_DB_SCHEMA="mastra"

# Probe the live gateway with `npm run check:models` — @mastra/core's bundled
# registry lists free models Zen does not actually serve.
SKILLFORGE_MODEL_FAST="hy3-free"
SKILLFORGE_MODEL_DEEP="hy3-free"
